library(ggplot2)
library(dplyr)
library(readr)
# Read your data
file_path <- "C:/Users/soham/OneDrive - IIT Indore/Research Work/sujay sir/Newsvendor/Thesis/Simulation/Non parametric/Data/Q_hat_m_NP_results.csv"
data <- read_csv(file_path)
# Ensure factors for proper ordering
data$n <- factor(data$n, levels = c(20, 50, 100, 500, 1000, 5000, 10000))
data$m <- factor(data$m)
data$eta <- factor(data$eta)
# Loop over each unique m value
unique_m <- unique(data$m)
for (m_val in unique_m) {
plot_data <- data %>% filter(m == m_val)
p <- ggplot(plot_data, aes(x = n, y = Q_hat_m_NP)) +
geom_boxplot(fill = "skyblue", outlier.size = 0.8) +
facet_wrap(~ "eta", labeller = label_both) +
labs(
title = bquote("Distribution of " ~ hat(Q)[.(m_val)*","*NP] ~ " under different " ~ eta),
x = "Sample Size (n)",
y = bquote(hat(Q)[.(m_val)*","*NP])
) +
theme_bw() +
theme(
strip.text = element_text(size = 10, face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1)
)
ggsave(
filename = paste0("Boxplot_Q_hat_m", m_val, "_NP.eps"),
plot = p, device = "eps", width = 8, height = 5, dpi = 600
)
}
