library(ggplot2)
library(readr)
# Read your data
file_path <- "C:/Users/soham/OneDrive - IIT Indore/Research Work/sujay sir/Newsvendor/Thesis/Simulation/Non parametric/Data/Q_hat_m_NP_results.csv"
data <- read_csv(file_path)
data$n <- as.factor(data$n)
# Create the plot
p <- ggplot(data, aes(x = n, y = Q_hat_m_NP)) +
geom_boxplot(fill = "skyblue", outlier.size = 0.8) +
facet_grid(m ~ eta, labeller = label_both) +
labs(
title = expression(paste("Distribution of ", hat(Q)[m]^"*", " under different ", eta, " and sample sizes")),
x = "Sample Size (n)", y = expression(hat(Q)[m]^"*")
) +
theme_bw() +
theme(
strip.text = element_text(size = 10, face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1)
)
# Output directory
output_dir <- "C:/Users/soham/OneDrive - IIT Indore/Research Work/sujay sir/Newsvendor/Thesis/Simulation/Non parametric/Figures"
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)
# Save as high-resolution EPS
ggsave(
filename = file.path(output_dir, "Boxplot_Q_hat_m_NP.eps"),
plot = p,
device = "eps",
width = 12,
height = 8,
units = "in",
dpi = 600
)
