suppressWarnings(eBeta_ab(sample))
}, error = function(e) {
nan_count <<- nan_count + 1
invalid_indices <<- c(invalid_indices, i)
return(NULL)
})
# Skip to next iteration if estimation failed
if (is.null(fit)) {
next
}
# Extract estimates
a <- fit$shape1
b <- fit$shape2
l <- fit$a
u <- fit$b
# Check for NaNs
if (any(is.na(c(l, u, a, b)))) {
nan_count <- nan_count + 1
invalid_indices <- c(invalid_indices, i)
next
}
# Check for feasibility: shape > 0, support contains data
if (a <= 0 || b <= 0 || l > min(sample) || u < max(sample)) {
infeasible_count <- infeasible_count + 1
invalid_indices <- c(invalid_indices, i)
next
}
# If passed all checks, store valid estimate
ebetapos20[i, ] <- c(l, u, a, b)
valid_count <- valid_count + 1
}
