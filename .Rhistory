library(zoo)
auxiliary_particle_filter <- function(spi_ts, theta, N = 100) {
T <- length(spi_ts)
mu <- theta[1]; phi <- theta[2]; sigma_eta <- theta[3]
h_particles <- matrix(0, nrow = N, ncol = T)
weights <- matrix(0, nrow = N, ncol = T)
# Initialize
h_particles[,1] <- rnorm(N, mean = mu, sd = sigma_eta / sqrt(1 - phi^2))
log_weights <- -0.5 * ((spi_ts[1] / exp(h_particles[,1] / 2))^2 + h_particles[,1])
weights[,1] <- exp(log_weights - max(log_weights))
weights[,1] <- weights[,1] / sum(weights[,1])
for (t in 2:T) {
# Step 2.1: Resample indices with high predictive weights
indices <- sample(1:N, size = N, replace = TRUE, prob = weights[,t-1])
h_prev <- h_particles[indices, t-1]
# Step 2.2: Predict mean
h_pred <- mu * (1 - phi) + phi * h_prev
# Step 2.3: Sample new particles
h_particles[,t] <- rnorm(N, mean = h_pred, sd = sigma_eta)
# Step 2.4: Update weights
log_weights <- -0.5 * ((spi_ts[t] / exp(h_particles[,t] / 2))^2 + h_particles[,t])
weights[,t] <- exp(log_weights - max(log_weights))
weights[,t] <- weights[,t] / sum(weights[,t])
}
# Estimate log-likelihood of SPI
loglik <- sum(log(rowMeans(weights + 1e-10)))
return(list(loglik = loglik, h = h_particles))
}
# Production likelihood given h_t
production_likelihood <- function(prod, h_samples, T_cov, WH_cov, theta_alpha) {
alpha0 <- theta_alpha[1]; alpha1 <- theta_alpha[2]; alpha2 <- theta_alpha[3]; sigma_eps <- theta_alpha[4]
Y <- length(prod)
# Compute annual mean volatility from h_samples (assume particles averaged)
h_mean <- colMeans(h_samples)
h_yearly <- tapply(h_mean, rep(1:Y, each = 12), mean)  # assuming h_samples has 12*Y months
mu_prod <- alpha0 * h_yearly + alpha1 * T_cov + alpha2 * WH_cov
ll <- sum(dnorm(prod, mean = mu_prod, sd = sigma_eps, log = TRUE))
return(ll)
}
# run PMMH
PMMH <- function(spi_ts, prod, T_cov, WH_cov, n_iter = 5000) {
# Initial values
theta_curr <- c(0, 0.9, 0.2)         # mu, phi, sigma_eta
alpha_curr <- c(1, 0.1, 0.1, 1)      # alpha0, alpha1, alpha2, sigma_eps
logpost_chain <- numeric(n_iter)
theta_chain <- matrix(NA, nrow = n_iter, ncol = 3)
alpha_chain <- matrix(NA, nrow = n_iter, ncol = 4)
for (iter in 1:n_iter) {
# Propose new theta
theta_prop <- theta_curr + rnorm(3, 0, c(0.05, 0.02, 0.01))
if (theta_prop[2] <= 0 || theta_prop[2] >= 1 || theta_prop[3] <= 0) {
logpost_chain[iter] <- -Inf
next
}
# Run particle filter
pf_curr <- auxiliary_particle_filter(spi_ts, theta_curr)
pf_prop <- auxiliary_particle_filter(spi_ts, theta_prop)
# Use mean h from prop to compute production likelihood
ll_curr <- production_likelihood(prod, pf_curr$h, T_cov, WH_cov, alpha_curr)
ll_prop <- production_likelihood(prod, pf_prop$h, T_cov, WH_cov, alpha_curr)
log_post_curr <- pf_curr$loglik + ll_curr
log_post_prop <- pf_prop$loglik + ll_prop
acc_prob <- min(1, exp(log_post_prop - log_post_curr))
if (runif(1) < acc_prob) {
theta_curr <- theta_prop
logpost_chain[iter] <- log_post_prop
} else {
logpost_chain[iter] <- log_post_curr
}
theta_chain[iter, ] <- theta_curr
alpha_chain[iter, ] <- alpha_curr  # Can also sample alpha with Gibbs or MH
}
return(list(theta_chain = theta_chain, alpha_chain = alpha_chain, logpost = logpost_chain))
}
