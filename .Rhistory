# Load required libraries
library(mvtnorm)
library(ggplot2)
library(dplyr)
# Particle Filter Function: Auxiliary Particle Filter
auxiliary_particle_filter <- function(SPI, theta, N = 1000) {
T <- length(SPI)
mu <- theta$mu
phi <- theta$phi
sigma_eta <- theta$sigma_eta
h_particles <- matrix(0, nrow = N, ncol = T)
weights <- rep(1 / N, N)
log_likelihood <- 0
# Initialize h_0
h_particles[, 1] <- rnorm(N, mean = mu, sd = sigma_eta / sqrt(1 - phi^2))
mean_forecast <- mu * (1 - phi) + phi * h_particles[, 1]
weights <- dnorm(SPI[1], mean = 0, sd = exp(0.5 * h_particles[, 1]))
weights <- weights / sum(weights)
log_likelihood <- log_likelihood + log(mean(weights))
for (t in 2:T) {
# Step 2.1: Importance weights based on predictive likelihood
mean_forecast <- mu * (1 - phi) + phi * h_particles[, t - 1]
tilde_weights <- dnorm(SPI[t], mean = 0, sd = exp(0.5 * mean_forecast))
tilde_weights <- tilde_weights * weights
tilde_weights <- tilde_weights / sum(tilde_weights)
# Step 2.2: Resample indices
ancestor_indices <- sample(1:N, size = N, replace = TRUE, prob = tilde_weights)
# Step 2.3: Propagate particles
h_particles[, t] <- mu * (1 - phi) + phi * h_particles[ancestor_indices, t - 1] +
sigma_eta * rnorm(N)
# Step 2.4: Compute weights
weights <- dnorm(SPI[t], mean = 0, sd = exp(0.5 * h_particles[, t]))
weights <- weights / sum(weights)
log_likelihood <- log_likelihood + log(mean(weights))
}
return(list(loglik = log_likelihood, h_particles = h_particles))
}
# Production likelihood given h_t
production_loglik <- function(production, h_particles, theta, T_index) {
Y <- length(production)
h_yearly <- sapply(1:Y, function(y) mean(h_particles[, T_index[y]]))
pred <- theta$alpha0 * h_yearly + theta$alpha1 * theta$T + theta$alpha2 * theta$WH
ll <- dnorm(production, mean = pred, sd = sqrt(theta$sigma2), log = TRUE)
return(sum(ll))
}
# PMMH function
run_pmmh <- function(SPI, production, T_index, T_cov, WH_cov, N_iter = 1000, N_particles = 1000) {
T <- length(SPI)
Y <- length(production)
# Initial parameter values
theta <- list(mu = 0, phi = 0.9, sigma_eta = 0.2,
alpha0 = 0.5, alpha1 = 0.5, alpha2 = 0.5,
sigma2 = 1, T = T_cov, WH = WH_cov)
chain <- list()
acc <- 0
pf_out <- auxiliary_particle_filter(SPI, theta, N = N_particles)
loglike_SPI <- pf_out$loglik
loglike_prod <- production_loglik(production, pf_out$h_particles, theta, T_index)
logpost_old <- loglike_SPI + loglike_prod
for (i in 1:N_iter) {
# Propose new parameters
theta_prop <- theta
theta_prop$mu <- rnorm(1, theta$mu, 0.1)
theta_prop$phi <- rnorm(1, theta$phi, 0.05)
theta_prop$sigma_eta <- abs(rnorm(1, theta$sigma_eta, 0.05))
theta_prop$alpha0 <- rnorm(1, theta$alpha0, 0.2)
theta_prop$alpha1 <- rnorm(1, theta$alpha1, 0.2)
theta_prop$alpha2 <- rnorm(1, theta$alpha2, 0.2)
theta_prop$sigma2 <- abs(rnorm(1, theta$sigma2, 0.1))
theta_prop$T <- T_cov
theta_prop$WH <- WH_cov
pf_prop <- auxiliary_particle_filter(SPI, theta_prop, N = N_particles)
loglike_SPI_prop <- pf_prop$loglik
loglike_prod_prop <- production_loglik(production, pf_prop$h_particles, theta_prop, T_index)
logpost_new <- loglike_SPI_prop + loglike_prod_prop
if (log(runif(1)) < logpost_new - logpost_old) {
theta <- theta_prop
logpost_old <- logpost_new
acc <- acc + 1
}
chain[[i]] <- theta
}
return(list(chain = chain, acceptance = acc / N_iter))
}
